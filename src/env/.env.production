# INFRASTRUCTURE CONFIG + SECRETS
# [Задаются окружением: ОС, K8s, Docker, Vercel Dashboard и т.п.]

# HTTP-порт приложения
PORT=

# Имя базы данных PostgreSQL
DB_NAME=

# Хост PostgreSQL (Neon: ep-xxx.region.aws.neon.tech)
POSTGRES_HOST=

# Порт PostgreSQL (по умолчанию 5432)
POSTGRES_PORT=

# Пользователь PostgreSQL
POSTGRES_USER=

# Пароль PostgreSQL
POSTGRES_PASSWORD=

# SSL для облачного PostgreSQL (Neon: true; локальный Docker: false)
POSTGRES_SSL=

# Секрет для подписи access JWT
ACCESS_TOKEN_SECRET=

# Секрет для подписи refresh JWT
REFRESH_TOKEN_SECRET=

# Учётные данные service account для Basic Auth (админские эндпoинты)
SA_LOGIN=

# Пароль service account для Basic Auth
SA_PASSWORD=

# SMTP-логин для отправки email
NODEMAILER_USER_TRANSPORT=

# SMTP-пароль для отправки email
NODEMAILER_PASSWORD_TRANSPORT=

# Базовый URL приложения — используется в ссылках подтверждения email
MAIN_URL=

# APPLICATION SETTINGS + DOMAIN SETTINGS
# [Задаются только в env-файлах]

# TTL access-токена в секундах (минимум 300)
ACCESS_TOKEN_LIFE_TIME=300

# TTL refresh-токена в секундах
REFRESH_TOKEN_LIFE_TIME=72000

# Подключать TestingModule (нужен для homework-checker на Vercel)
INCLUDE_TESTING_MODULE=true

# Временно отключено для задания; вернуть true для включения IP rate limiting
IP_RESTRICTION_ENABLED=false
