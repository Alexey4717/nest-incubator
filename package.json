{
  "name": "it-incubator",
  "version": "0.0.1",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "yarn@1.22.22",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build && tsc-alias -p tsconfig.build.json",
    "vercel-build": "cross-env NODE_ENV=production yarn migration:run && yarn build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "cross-env NODE_ENV=development nest start --watch",
    "start:debug": "cross-env NODE_ENV=development nest start --debug --watch",
    "start:staging": "cross-env NODE_ENV=staging nest start",
    "start:prod": "cross-env NODE_ENV=production node dist/main",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "cross-env NODE_ENV=testing jest --watch",
    "test:cov": "cross-env NODE_ENV=testing jest --coverage",
    "test:debug": "cross-env NODE_ENV=testing node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "cross-env NODE_ENV=testing jest --config ./src/__test__/jest-e2e.json --runInBand",
    "typeorm": "node -r tsconfig-paths/register ./node_modules/typeorm/cli-ts-node-commonjs.js -d src/modules/database/data-source.ts",
    "migration:generate": "node scripts/migration-generate.js",
    "migration:run": "yarn typeorm migration:run",
    "migration:revert": "yarn typeorm migration:revert",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:migrate": "yarn migration:run",
    "db:migrate:test": "cross-env NODE_ENV=testing yarn migration:run",
    "db:migrate:prod": "cross-env NODE_ENV=production yarn migration:run",
    "db:setup": "yarn db:up && yarn db:migrate && yarn db:migrate:test",
    "db:seed": "cross-env NODE_ENV=development node -r tsconfig-paths/register -r ts-node/register scripts/seed.ts",
    "db:seed:bulk": "cross-env NODE_ENV=development node -r tsconfig-paths/register -r ts-node/register scripts/benchmark/seed-bulk.ts",
    "db:seed:bulk:clean": "cross-env NODE_ENV=development node -r tsconfig-paths/register -r ts-node/register scripts/benchmark/seed-bulk.ts -- --clean",
    "db:explain": "cross-env NODE_ENV=development node -r tsconfig-paths/register -r ts-node/register scripts/benchmark/run-explain.ts",
    "db:index-audit": "cross-env NODE_ENV=development node -r tsconfig-paths/register -r ts-node/register scripts/benchmark/run-index-audit.ts",
    "db:benchmark": "cross-env NODE_ENV=development node -r tsconfig-paths/register -r ts-node/register scripts/benchmark/run-benchmark.ts",
    "db:benchmark:quick": "cross-env NODE_ENV=development node -r tsconfig-paths/register -r ts-node/register scripts/benchmark/run-benchmark.ts -- --quick",
    "db:benchmark:insert-pk": "cross-env NODE_ENV=development node -r tsconfig-paths/register -r ts-node/register scripts/benchmark/bench-insert-pk.ts",
    "db:benchmark:insert-pk:quick": "cross-env NODE_ENV=development node -r tsconfig-paths/register -r ts-node/register scripts/benchmark/bench-insert-pk.ts -- --quick"
  },
  "dependencies": {
    "@nestjs-modules/mailer": "^1.8.1",
    "@nestjs/common": "^9.0.0",
    "@nestjs/core": "^9.0.0",
    "@nestjs/cqrs": "^10.2.8",
    "@nestjs/jwt": "^10.0.0",
    "@nestjs/passport": "^9.0.0",
    "@nestjs/platform-express": "^9.0.0",
    "@nestjs/schedule": "^2.2.3",
    "@nestjs/serve-static": "^3.0.1",
    "@nestjs/swagger": "^6.3.0",
    "@nestjs/throttler": "^4.0.0",
    "@nestjs/typeorm": "^11.0.3",
    "@types/bcrypt": "^5.0.0",
    "@types/nodemailer": "^6.4.7",
    "bcrypt": "^5.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cookie-parser": "^1.4.7",
    "cross-env": "^7.0.3",
    "date-fns": "^2.29.3",
    "module-alias": "^2.3.4",
    "nodemailer": "^6.9.1",
    "passport": "^0.7.0",
    "passport-http": "^0.3.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.2.0",
    "typeorm": "^1.0.0",
    "uuidv7": "^1.2.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^9.0.0",
    "@nestjs/config": "^2.3.1",
    "@nestjs/schematics": "^9.0.0",
    "@nestjs/testing": "^9.0.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.13",
    "@types/jest": "29.5.0",
    "@types/module-alias": "^2.0.4",
    "@types/node": "18.15.11",
    "@types/passport-http": "^0.3.11",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^2.0.11",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "eslint": "^8.0.1",
    "eslint-config-prettier": "^9",
    "eslint-plugin-prettier": "^5",
    "jest": "29.5.0",
    "prettier": "^3",
    "supertest": "^6.1.3",
    "ts-jest": "29.0.5",
    "ts-node": "^10.0.0",
    "tsc-alias": "^1.8.17",
    "tsconfig-paths": "4.2.0",
    "typescript": "^4.7.4"
  },
  "jest": {
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "modules/**/application/**/*.ts",
      "modules/**/domain/**/*.ts",
      "modules/**/guards/**/*.ts",
      "modules/**/strategies/**/*.ts",
      "modules/**/models/**/*.ts",
      "core/**/*.ts",
      "!**/*.spec.ts",
      "!**/*.module.ts",
      "!**/*.d.ts",
      "!**/__test__/**",
      "!core/swagger/**",
      "!core/dto/**"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
